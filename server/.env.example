PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fitcore?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_secure_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
SEED_ADMIN_EMAIL=admin@fitcore.com
SEED_ADMIN_PASSWORD=change_admin_secret_123
SEED_TRAINER_EMAIL=trainer@fitcore.com
SEED_TRAINER_PASSWORD=change_trainer_secret_123

# Razorpay Test / Production Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="FitCore Gym" <no-reply@fitcore.com>

